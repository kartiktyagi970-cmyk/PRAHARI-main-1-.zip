# ---------------------------------------------------------------------------
# ElevateX Digital — environment variables
# Copy this file to `.env` (local) or add the same keys in your host dashboard.
# Never commit your real `.env` file.
#
# The website builds, runs and renders with NONE of these set.
# They only control where form submissions are stored / sent.
# Check what is active at any time: /api/health
# ---------------------------------------------------------------------------

# 1) DATABASE (recommended) — PostgreSQL connection string.
#    Free: https://neon.tech or https://supabase.com (copy the POOLED string).
#    LOCAL EXAMPLE (only if PostgreSQL is actually running on your machine):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
#    After adding it, create the tables once:
#      npx drizzle-kit push

# 2) NO-DATABASE OPTION — paste a Formspree endpoint or any webhook that
#    accepts JSON. Every enquiry is POSTed there. Free at https://formspree.io
# FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# 3) OPTIONAL email notifications for new enquiries (needs a verified domain).
#    Free tier at https://resend.com. Enquiries are stored either way.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=kartiktyagi970@gmail.com
# CONTACT_FROM_EMAIL=ElevateX Website <hello@yourdomain.com>

# 4) OPTIONAL — public site URL used for canonical links, Open Graph and sitemap.
# NEXT_PUBLIC_SITE_URL=https://www.elevatex.website

# 5) OPTIONAL — disable the local .data/*.jsonl file fallback (regular servers only).
# DISABLE_FILE_STORAGE=true
